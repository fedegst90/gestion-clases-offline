<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondos"
    android:padding="16dp"
    tools:context=".ui.colegios.ColegiosFragment">

    <TextView
        android:id="@+id/tvColegioTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:text="Seccion colegios"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/white"
        android:iconifiedByDefault="false"
        android:queryHint="Buscar colegio..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvColegioTitle"
        app:queryBackground="@color/white" />

    <!-- Image to the left of the RecyclerView -->
    <ImageView
        android:id="@+id/imgLeft"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_left"
        android:layout_marginEnd="-20dp"
        app:layout_constraintEnd_toStartOf="@id/rvColegios"
        app:layout_constraintTop_toTopOf="@id/rvColegios"
        app:layout_constraintBottom_toBottomOf="@id/rvColegios" />

    <!-- RecyclerView in the center -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvColegios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchView" />

    <!-- Image to the right of the RecyclerView -->
    <ImageView
        android:id="@+id/imgRight"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_right"
        android:layout_marginStart="-20dp"
        app:layout_constraintStart_toEndOf="@id/rvColegios"
        app:layout_constraintTop_toTopOf="@id/rvColegios"
        app:layout_constraintBottom_toBottomOf="@id/rvColegios" />

    <Button
        android:id="@+id/btnAddColegio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/segundo"
        android:text="@string/btn_agregar_colegio"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvColegios" />

    <LinearLayout
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAddColegio">
        <include
            android:id="@+id/includeItemColegio"
            layout="@layout/item_colegio" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
